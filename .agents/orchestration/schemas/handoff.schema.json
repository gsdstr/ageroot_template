{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutral orchestration handoff",
  "type": "object",
  "required": ["id", "from_phase", "to_phase", "producer_role", "consumer_role", "artifact_schema"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "from_phase": {"enum": ["intake", "research-planning", "implementation", "review-integration"]},
    "to_phase": {"enum": ["intake", "research-planning", "implementation", "review-integration"]},
    "producer_role": {"enum": ["Owner", "Coordinator", "Researcher", "Author", "Builder", "Reviewer", "Integrator"]},
    "consumer_role": {"enum": ["Owner", "Coordinator", "Researcher", "Author", "Builder", "Reviewer", "Integrator"]},
    "artifact_schema": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
