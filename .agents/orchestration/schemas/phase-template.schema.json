{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutral orchestration phase template",
  "type": "object",
  "required": ["metadata", "participating_roles", "entry_criteria", "exit_criteria", "handoff_artifacts", "budget_slice", "escalation_gates"],
  "properties": {
    "metadata": {"type": "object", "required": ["id", "phase_index", "name", "summary"]},
    "participating_roles": {"type": "array", "minItems": 1, "items": {"enum": ["Owner", "Coordinator", "Researcher", "Author", "Builder", "Reviewer", "Integrator"]}},
    "entry_criteria": {"type": "object"},
    "exit_criteria": {"type": "object"},
    "handoff_artifacts": {"type": "array"},
    "budget_slice": {"type": "object"},
    "escalation_gates": {"type": "array"}
  },
  "additionalProperties": false
}
